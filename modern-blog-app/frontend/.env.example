# ============================================================================
# SUPABASE CONFIGURATION (Required)
# ============================================================================

# Supabase Project URL (Public - safe to expose)
# Get from: Supabase Dashboard → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anon Key (Public - safe for browser operations)
# Get from: Supabase Dashboard → Settings → API → Project API keys → anon
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ.........................................

# Supabase Service Role Key (PRIVATE - Server-side only!)
# ⚠️ NEVER expose this in frontend code or commit to git!
# Get from: Supabase Dashboard → Settings → API → Project API keys → service_role
SUPABASE_SERVICE_ROLE_KEY=eyJ.....................................

# ============================================================================
# SITE METADATA
# ============================================================================

NEXT_PUBLIC_SITE_NAME=Personal Tech Blog - DevOps, Security & Cloud
NEXT_PUBLIC_SITE_DESCRIPTION=Weekly AI-generated insights on DevOps, Cloud Computing, Security, and AI/Automation
NEXT_PUBLIC_AUTHOR=Your Name
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
NEXT_PUBLIC_COMPANY_NAME=Your Company
NEXT_PUBLIC_COMPANY_DOMAIN=yourdomain.com

# ============================================================================
# AI AGENT CONFIGURATION (For Automated Blog Generation)
# ============================================================================

# Google Gemini API Key (LLM Provider - 100% FREE Tier)
# Sign up: https://ai.google.dev
# Get API key: Google AI Studio → Get API Key
# Free tier: 60 requests per minute, unlimited tokens
# Model used: gemini-3.5-flash (fast & cost-effective)
# Cost: FREE forever ($0/month)
# ⚠️ NOTE: Variable name MUST be: GOOGLE_GENERATIVE_AI_API_KEY (for AI SDK)
GOOGLE_GENERATIVE_AI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Tavily AI API Key (Web Search - 100% FREE Tier)
# Sign up: https://tavily.com
# Get API key: Settings → API Keys
# Free tier: 1,000 API calls per month (enough for 250+ weeks of posts)
# Used for: Searching latest DevOps/Security/Cloud updates
# Cost: FREE forever ($0/month)
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxx

# Vercel Cron Secret (Security - prevent unauthorized cron calls)
# Generate: Random 32+ character string (use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# ⚠️ NEVER commit this to git or share publicly
# Used to verify legitimate Vercel cron requests
CRON_SECRET=your-secret-cron-key-here-min-32-chars

# ============================================================================
# OPTIONAL: ADDITIONAL AI SERVICES (Fallback/Alternative)
# ============================================================================

# OpenAI API Key (Alternative LLM - Paid option, ~$15-50/month)
# Sign up: https://platform.openai.com
# Get API key: Organization → API Keys
# NOT RECOMMENDED: Use Google Gemini (free) instead
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxx

# ============================================================================
# ANALYTICS & MONITORING (Optional)
# ============================================================================

# PostHog Analytics (Optional)
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxx

# Sentry Error Tracking (Optional)
SENTRY_AUTH_TOKEN=sntrys_xxxxxxxxxxxxx
