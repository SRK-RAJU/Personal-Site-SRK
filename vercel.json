{
  "buildCommand": "npm run build",
  "installCommand": "npm install --legacy-peer-deps",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "functions": {
    "/app/api/**/*.ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "crons": [
    {
      "path": "/api/posts/ai/generate",
      "schedule": "0 3 * * 1"
    },
    {
      "path": "/api/posts/ai/generate?test=true",
      "schedule": "0 0 1 1 *"
    },
    {
      "path": "/api/posts/ai/check-deployment",
      "schedule": "0 0 * * *"
    }
  ]
}
