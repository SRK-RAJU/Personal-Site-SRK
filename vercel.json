{
  "buildCommand": "npm run build",
  "installCommand": "npm install --legacy-peer-deps",
  "framework": "nextjs",
  "functions": {
    "app/api/**/*.ts": {
      "maxDuration": 300,
      "memory": 2048
    }
  },
  "crons": [
    {
      "path": "/api/ai-agent/generate-post",
      "schedule": "0 3 * * 1"
    },
    {
      "path": "/api/ai-agent/check-deployment",
      "schedule": "*/5 * * * *"
    }
  ],
  "env": {
    "CRON_ENABLED": "true"
  }
}
